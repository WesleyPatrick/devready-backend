# Copie para .env e preencha. O .env nunca vai para o git.

# Imagens
GHCR_OWNER=seu-usuario-github
DEVREADY_VERSION=latest
WEB_PORT=80

# Banco da aplicação
DATABASE_NAME=devready
DATABASE_USER=devready
DATABASE_PASSWORD=troque-esta-senha

# RabbitMQ
RABBITMQ_USER=devready
RABBITMQ_PASSWORD=troque-esta-senha

# Segurança
JWT_SECRET=gere-com-openssl-rand-base64-48-e-cole-aqui-com-pelo-menos-32-caracteres
FRONTEND_URL=http://localhost
# Login social. Cada provedor só entra com o id e o segredo preenchidos; vazio, a API sobe sem ele e
# a tela de login não mostra o botão.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Administrador criado na primeira subida. A senha passa pela mesma regra do cadastro (8 caracteres
# ou mais, até 72 bytes); o valor abaixo tem 6 de propósito, para a API recusar subir até ser trocado.
# Deixe as duas vazias para não criar ninguém.
DEVREADY_ADMIN_EMAIL=admin@devready.local
DEVREADY_ADMIN_PASSWORD=troque
